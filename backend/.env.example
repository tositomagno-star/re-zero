# Local development database. Replace these placeholders in your private .env file.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@127.0.0.1:5432/cronicas_do_reino_dev

# Dedicated database used only by tests marked "postgres".
TEST_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@127.0.0.1:5432/cronicas_do_reino_test

FRONTEND_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]
APP_ENVIRONMENT=development
COOKIE_SECURE=false
PLAYER_SESSION_HOURS=12
ADMIN_SESSION_HOURS=4
AUTH_RATE_LIMIT_ATTEMPTS=5
AUTH_RATE_LIMIT_MINUTES=15
AUTH_LOCKOUT_MINUTES=15
ASSET_STORAGE_PATH=uploads/assets
ASSET_MAX_UPLOAD_BYTES=5242880
